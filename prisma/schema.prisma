generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Host {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String    @map("password_hash")
  resetToken           String?   @unique @map("reset_token")
  resetTokenExpiresAt  DateTime? @map("reset_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  quizzes Quiz[]

  @@map("hosts")
}

model Quiz {
  id                   String   @id @default(uuid())
  title                String
  mode                 String
  state                String   @default("created")
  hostCode             String   @map("host_code") @db.VarChar(6)
  joinCode             String   @unique @map("join_code") @db.VarChar(6)
  hostId               String?  @map("host_id")
  currentRoundIndex    Int      @default(0) @map("current_round_index")
  currentQuestionIndex Int?     @map("current_question_index")
  createdAt            DateTime @default(now()) @map("created_at")

  host         Host?         @relation(fields: [hostId], references: [id])
  rounds       Round[]
  participants Participant[]
  teams        Team[]
  submissions  Submission[]

  @@map("quizzes")
}

model Round {
  id     String @id @default(uuid())
  quizId String @map("quiz_id")
  title  String
  order  Int

  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("rounds")
}

model Question {
  id                 String @id @default(uuid())
  roundId            String @map("round_id")
  text               String
  options            Json
  correctOptionIndex Int    @map("correct_option_index")
  timeLimitSeconds   Int    @default(30) @map("time_limit_seconds")
  order              Int

  round       Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("questions")
}

model Participant {
  id        String   @id @default(uuid())
  quizId    String   @map("quiz_id")
  name      String
  teamId    String?  @map("team_id")
  isCaptain Boolean  @default(false) @map("is_captain")
  socketId  String?  @map("socket_id")
  score     Int      @default(0)
  joinedAt  DateTime @default(now()) @map("joined_at")

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id])
  submissions Submission[]

  @@map("participants")
}

model Team {
  id        String   @id @default(uuid())
  quizId    String   @map("quiz_id")
  name      String
  captainId String   @map("captain_id")
  score     Int      @default(0)
  joinedAt  DateTime @default(now()) @map("joined_at")

  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  participants Participant[]
  submissions  Submission[]

  @@map("teams")
}

model Submission {
  id                  String   @id @default(uuid())
  quizId              String   @map("quiz_id")
  questionId          String   @map("question_id")
  participantId       String   @map("participant_id")
  teamId              String?  @map("team_id")
  selectedOptionIndex Int      @map("selected_option_index")
  isCorrect           Boolean  @map("is_correct")
  submittedAt         DateTime @default(now()) @map("submitted_at")

  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id])

  @@unique([questionId, participantId])
  @@map("submissions")
}
